# Public URL of the deployed site. Drives canonical, Open Graph and sitemap.
NEXT_PUBLIC_SITE_URL=https://audit.auto8.ai

# The embedded audit tool. Change only if the tool moves.
NEXT_PUBLIC_AUDIT_EMBED_SRC=https://audit.gbp.auto8.ai/light-audit/search

# Analytics. Each is optional and the tag is skipped when the value is empty.
# Prefer GTM on its own and manage GA4 and the Meta pixel inside it, so no tag
# gets loaded twice and conversions are not double counted.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
